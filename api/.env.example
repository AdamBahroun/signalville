# Copier ce fichier vers api/.env puis remplir JWT_SECRET. Ne jamais commiter api/.env.
# Toutes les valeurs vides retombent sur le défaut du code (config.js).

# OBLIGATOIRE : 32 caractères minimum
# Générer avec : node -p "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=

# Adresse de MongoDB (défaut : base locale tuniins sur 127.0.0.1)
MONGODB_URI=

# Port d'écoute de l'API (défaut : 3000)
PORT=

# Durée de validité des jetons (défaut : 1h)
JWT_EXPIRES_IN=

# Coût de hachage bcrypt (défaut : 10)
BCRYPT_ROUNDS=

# Facultatif : fichier du compte de service Firebase (vide = notifications désactivées)
# Ne jamais commiter ce fichier JSON
FIREBASE_SERVICE_ACCOUNT_PATH=

# Facultatif : réglages de la commune et des limites (valeurs par défaut pour Nabeul)
# COMMUNE_LAT=
# COMMUNE_LNG=
# COMMUNE_RAYON_M=
# LIMITE_SIGNALEMENTS_PAR_JOUR=
# CONFIRMATION_RAYON_M=
# LIMITE_CONFIRMATIONS_PAR_JOUR=
# SIMILARITE_FACTEUR_RAYON=